# ================================
# Rabbi Eitan - Environment Variables
# ================================
# Copy this file to .env and fill in your values

# --------------------------
# Database Configuration
# --------------------------
DATABASE_URL=postgresql://rabbi_user:rabbi_pass@postgres:5432/rabbi_eitan
REDIS_URL=redis://redis:6379/0

# --------------------------
# API Keys
# --------------------------
# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs (Audio Generation)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_preferred_voice_id

# HeyGen (Video Avatar)
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_AVATAR_ID=your_avatar_id

# OpenAI (Whisper Transcription)
OPENAI_API_KEY=your_openai_api_key_here

# --------------------------
# Telegram Configuration
# --------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_ID=your_telegram_user_id
TELEGRAM_CHANNEL_ID=@your_channel_name

# --------------------------
# WhatsApp Configuration
# --------------------------
WHATSAPP_API_URL=https://api.green-api.com
WHATSAPP_INSTANCE_ID=your_instance_id
WHATSAPP_API_TOKEN=your_api_token

# --------------------------
# Application Settings
# --------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Secret key for JWT tokens
SECRET_KEY=your_super_secret_key_change_in_production

# --------------------------
# Content Source
# --------------------------
CHABAD_TANYA_URL=https://www.chabad.org/dailystudy/tanya.htm

# --------------------------
# Media Settings
# --------------------------
# Background music volume (0.0 to 1.0)
BACKGROUND_MUSIC_VOLUME=0.15

# Video compression target resolution for WhatsApp
WHATSAPP_VIDEO_RESOLUTION=720

# --------------------------
# Celery Task Settings
# --------------------------
# HeyGen timeout in seconds (30 minutes)
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1740
